@host = http://localhost:5107

### Create
POST {{host}}/api/task
Content-Type: application/json

{ "title": "First", "status": "todo", "priority": "high" }

### Get all
GET {{host}}/api/task

### Get one (use the id from the create response)
GET {{host}}/api/task/PASTE-GUID-HERE

### Update
PUT {{host}}/api/task/PASTE-GUID-HERE
Content-Type: application/json

{ "title": "Updated", "status": "inProgress", "priority": "low" }

### Delete
DELETE {{host}}/api/task/PASTE-GUID-HERE